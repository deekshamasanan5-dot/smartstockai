# ==========================================
# SUPABASE CONFIGURATION (Backend & Server)
# ==========================================
# Get these from: Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Public API anon key for client-safe queries (uses Row Level Security)
SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE_SERVICE_ROLE_KEY: Secret backend admin key (bypasses RLS for secure server tasks)
# Keep this secret and NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ==========================================
# CLIENT-SIDE SUPABASE CONFIGURATION (Vite)
# ==========================================
# Vite automatically exposes variables prefixed with VITE_ to the browser.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ==========================================
# BACKEND SERVER & API CONFIGURATION
# ==========================================
PORT=3001
VITE_API_URL="http://localhost:3001"

# ==========================================
# GEMINI AI CONFIGURATION
# ==========================================
# GEMINI_API_KEY: Required for Gemini AI API calls (forecasting, stock insights).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
